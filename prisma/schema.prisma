// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  bio            String
  profilePicture String?  // Optional profile picture field
  isActive       Boolean  @default(false) // Field for account activation
  otp            String?  // Field to store the OTP for email verification
  createdAt      DateTime @default(now())  // Field to store the creation date

 // Relation for users who follow this user
  followedBy      Follow[]  @relation("Follower")
  
  // Relation for users that this user follows
  follows         Follow[]  @relation("Following")
}

model Follow {
  id               Int      @id @default(autoincrement())
  followerEmail    String
  followingEmail   String

  // User who is following
  follower         User     @relation("Following", fields: [followerEmail], references: [email])
  
  // User who is being followed
  following        User     @relation("Follower", fields: [followingEmail], references: [email])

  @@unique([followerEmail, followingEmail]) // Ensure that the combination of emails is unique
}

model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  ingredients  String
  instructions String
  image        String?  // Optional field for storing image URL or path
  videoLink    String?  // Optional field for storing YouTube video link
  email        String   // Non-optional field for storing the email of the user
  createdAt    DateTime @default(now()) // Field to store creation date, defaulting to now
  visibility    String?   // Field to indicate if the recipe is public or private
}

model Admin {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


